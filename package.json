{
  "name": "pulseo",
  "version": "0.1.0",
  "description": "Self-hosted, multi-tenant client portal built with Next.js 16, Drizzle, PostgreSQL and Better Auth.",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:generate:projects": "drizzle-kit generate --config drizzle.projects.config.ts",
    "db:migrate:projects": "tsx src/modules/projects/schema/migrate.ts",
    "test:projects": "vitest run src/modules/projects",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "activity:backfill": "tsx src/lib/activity/backfill.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-email/components": "^1.0.10",
    "@swc/helpers": "^0.5.21",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@xyflow/react": "12.5.2",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "driver.js": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "5.2.5",
    "graphile-worker": "0.16.6",
    "iconv-lite": "0.7.0",
    "isomorphic-dompurify": "^2.36.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.4",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "resend": "^6.9.4",
    "shadcn": "^4.1.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "yaml": "2.7.0",
    "yauzl": "3.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
