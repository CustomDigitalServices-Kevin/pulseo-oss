# ============================================================================
# Pulseo - Environment configuration template
#
# RENAME this file to `.env` for local development (or `.env.production` for
# production deployments). The leading dot is required by Next.js / dotenv.
# Never commit your filled-in `.env` files - they are listed in `.gitignore`.
#
# Quickstart:
#   cp env.example .env
#   # then fill in DATABASE_URL and BETTER_AUTH_SECRET at minimum
# ============================================================================

# ----------------------------------------------------------------------------
# Database (required)
# ----------------------------------------------------------------------------
# PostgreSQL connection string. Locally, you can spin one up with Docker:
#   docker run --name pulseo-pg -e POSTGRES_PASSWORD=pulseo -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://pulseo:pulseo@localhost:5432/pulseo

# ----------------------------------------------------------------------------
# Better Auth (required)
# ----------------------------------------------------------------------------
# Generate a 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace_me_with_32_or_more_random_chars_______
# Canonical URL Better Auth should issue cookies and magic links for.
BETTER_AUTH_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Branding (required for production, optional for dev)
#
# Every NEXT_PUBLIC_* below feeds `src/config/app-config.ts`. The portal
# stays fully functional with the bundled defaults, but override these the
# moment you deploy under your own brand.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Pulseo
NEXT_PUBLIC_APP_TAGLINE=Your client portal, simplified.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=Your Company
NEXT_PUBLIC_COMPANY_SHORT=Your Co.
NEXT_PUBLIC_COMPANY_DESCRIPTION=Client portal for tickets, contracts, documents and dashboards.
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NEXT_PUBLIC_DPO_EMAIL=privacy@example.com
NEXT_PUBLIC_PRIMARY_COLOR=#2563EB
NEXT_PUBLIC_SECONDARY_COLOR=#1E40AF
# ISO 3166-1 alpha-2 country (FR, US, CA, ...)
NEXT_PUBLIC_COMPANY_COUNTRY=FR
# Public business identifier (SIREN, EIN, company number, ...)
NEXT_PUBLIC_COMPANY_REGISTRATION=000000000

# ----------------------------------------------------------------------------
# Email - Resend (https://resend.com) (optional in dev)
#
# Without a key, Pulseo logs outgoing emails to stdout. Magic-link sign-in
# still works in dev because the link is printed to the console.
# ----------------------------------------------------------------------------
RESEND_API_KEY=
# Format: `App Name <noreply@your-verified-domain.tld>`
EMAIL_FROM=Pulseo <onboarding@resend.dev>
# Set to `false` to silence all outgoing email globally (deploys, incidents).
EMAIL_ENABLED=true

# ----------------------------------------------------------------------------
# Database seed (optional - only used by `npm run db:seed`)
# ----------------------------------------------------------------------------
# Email of an existing Better Auth account that should be flagged as
# platform super-admin and member of the demo organizations.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD_HINT=(set during sign-up)

# ----------------------------------------------------------------------------
# Optional integrations
# ----------------------------------------------------------------------------
# Antivirus scan for uploaded files via ClamAV (see docker-compose.clamav.yml)
CLAMAV_HOST=
CLAMAV_PORT=3310
# Cron secret for /api/cron/* endpoints (required if you expose them publicly).
CRON_SECRET=
